#!/bin/sh
#
# Check IPsec Tunnel Status and Uptime on pfSense using swanctl
# usage: ./check_pf_ipsec_swanctl.sh -c <con-name> [child-suffix]
#

# Helper function to convert seconds to human readable time
format_time() {
    local seconds=$1
    
    # Check if input is a valid number
    if ! [ "$seconds" -eq "$seconds" ] 2>/dev/null; then
        echo "unknown time"
        return
    fi

    if [ "$seconds" -lt 60 ]; then
        echo "${seconds} seconds"
    elif [ "$seconds" -lt 3600 ]; then
        # Calculate minutes
        local minutes=$((seconds / 60))
        echo "${minutes} minutes"
    else
        # Calculate hours
        local hours=$((seconds / 3600))
        echo "${hours} hours"
    fi
}

if [ "$1" = "-c" ]; then
    # Default exit status (Critical)
    exitstatus=2

    ike_name="$2"
    child_suffix="$3"

    # Define the swanctl binary path
    SWANCTL="/usr/local/sbin/swanctl"

    # 1. Query swanctl for the specific IKE SA
    # We capture both stdout and stderr to handle cases where the daemon is down
    output=$($SWANCTL --list-sas --ike "$ike_name" 2>&1)
    
    # Check if command failed entirely
    if [ $? -ne 0 ]; then
        echo "UNKNOWN: Failed to execute swanctl. Check permissions or service status."
        exit 3
    fi

    # 2. Check Phase 1 (IKE SA) Status
    if echo "$output" | grep -q "$ike_name:.*ESTABLISHED"; then
        p1_status="ESTABLISHED"
        
        # Extract raw seconds for P1.
        # Logic: Find the IKE line, look at the next few lines for "established", grab the number before 's'
        # Example line: "established 1450s ago, rekeying in..."
        raw_p1_time=$(echo "$output" | grep -A 10 "$ike_name:.*ESTABLISHED" | grep -m 1 "established" | awk '{print $2}' | tr -d 's')
        
        p1_readable=$(format_time "$raw_p1_time")
    else
        p1_status="DOWN"
        p1_readable="N/A"
    fi

    # 3. Check Phase 2 (Child SA) Status
    if [ -n "$child_suffix" ]; then
        child_name="${ike_name}_${child_suffix}"
    else
        child_name="$ike_name"
    fi

    # We look for the child name followed eventually by "INSTALLED"
    if echo "$output" | grep -q "$child_name:.*INSTALLED"; then
        p2_status="INSTALLED"
        
        # Extract raw seconds for P2.
        # Logic: Find the child line, look for "installed", grab number before 's'
        # Note: We must ensure we grep the Child SA block, not the parent IKE block again.
        # We grep for the child name, then look for the first "installed" line appearing after it.
        raw_p2_time=$(echo "$output" | grep -A 10 "$child_name:.*INSTALLED" | grep -m 1 "installed" | awk '{print $2}' | tr -d 's')
        
        p2_readable=$(format_time "$raw_p2_time")
    else
        p2_status="DOWN"
        p2_readable="N/A"
    fi

    # 4. Determine Final Nagios State
    if [ "$p1_status" = "DOWN" ]; then
        echo "CRITICAL: IPSEC IKE_SA '$ike_name' is NOT ESTABLISHED"
        exitstatus=2
    elif [ "$p2_status" = "DOWN" ]; then
        echo "CRITICAL: IPSEC IKE_SA '$ike_name' UP ($p1_readable ago), but Child SA '$child_name' is DOWN"
        exitstatus=2
    else
        echo "OK: IPSEC '$ike_name' UP ($p1_readable ago), Child '$child_name' UP ($p2_readable ago)"
        exitstatus=0
    fi

    exit $exitstatus

else
    echo "check_pf_ipsec_tunnel - Nagios Plugin for checking IPSEC status + uptime"
    echo ""
    echo "Usage:    ./check_pf_ipsec_tunnel -c <Connection Name> <Child Suffix>"
    echo "Example:  ./check_pf_ipsec_tunnel -c con1"
	echo "Example:  ./check_pf_ipsec_tunnel -c con1 2"
    exit 3
fi
